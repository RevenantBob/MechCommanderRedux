# Writes MCVersion.h as MechCommander.props's MCGenerateVersionHeader does on Windows: Nerdbank.GitVersioning (nbgv,
# the local dotnet tool in dotnet-tools.json) computes the version from version.json and the git history. Without
# dotnet or git (a source zip), the version falls back to 0.0.0.0. The file is only rewritten when the version
# changes, so unchanged builds stay incremental.
# cmake -DREPO_DIR=<repository> -DOUTPUT=<MCVersion.h> -P version.cmake

set(version "0.0.0.0")
set(semver "0.0.0-unknown")
set(commit "unknown")
find_program(DOTNET dotnet)

if(DOTNET)
  execute_process(COMMAND ${DOTNET} tool restore WORKING_DIRECTORY ${REPO_DIR} RESULT_VARIABLE restored
                  OUTPUT_QUIET ERROR_QUIET)

  if(restored EQUAL 0)
    execute_process(COMMAND ${DOTNET} nbgv get-version -v Version WORKING_DIRECTORY ${REPO_DIR}
                    RESULT_VARIABLE got OUTPUT_VARIABLE nbgv_version OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)

    if(got EQUAL 0)
      set(version ${nbgv_version})
      execute_process(COMMAND ${DOTNET} nbgv get-version -v SemVer2 WORKING_DIRECTORY ${REPO_DIR}
                      OUTPUT_VARIABLE semver OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
      execute_process(COMMAND ${DOTNET} nbgv get-version -v GitCommitIdShort WORKING_DIRECTORY ${REPO_DIR}
                      OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    endif()
  endif()
endif()

if(version STREQUAL "0.0.0.0")
  message(WARNING "Could not get the version from nbgv (needs the .NET SDK and a git checkout); using 0.0.0.0.")
endif()

string(REPLACE "." "," commas ${version})
set(header "// Generated by src/mac/version.cmake from version.json and the git history. Do not edit.
#pragma once
#define MC_VERSION \"${version}\"
#define MC_VERSION_COMMAS ${commas}
#define MC_VERSION_SEMVER \"${semver}\"
#define MC_VERSION_COMMIT \"${commit}\"
")

if(EXISTS ${OUTPUT})
  file(READ ${OUTPUT} previous)
endif()

if(NOT previous STREQUAL header)
  file(WRITE ${OUTPUT} "${header}")
endif()

message(STATUS "MechCommander Redux ${version} (${commit})")

// The composite of a view: the screen (UI) over the world view's surface, in palette indices, then the palette.
//
// Drawn by MCDisplay over each underlay's rectangle of the screen with SDL's GPU renderer (SDL_GPURenderState): the
// drawn texture (t0) is the screen; the others are bound after it. A screen pixel other than the key (255) is shown
// as it is. A key pixel shows the world pixel under its centre (nearest), mapped through the op table its op names
// (row 0 is the identity): a translucent UI draw over the world recorded its palette table there. This is
// MCRenderer::ComposeUnderlays, which the CPU uses for screenshots and tests, done per pixel.

Texture2D<float> screenTex : register(t0, space2);
SamplerState screenSampler : register(s0, space2);
// The screen's op plane: one byte per screen pixel.
Texture2D<float> opTex : register(t1, space2);
SamplerState opSampler : register(s1, space2);
// The world view's surface.
Texture2D<float> worldTex : register(t2, space2);
SamplerState worldSampler : register(s2, space2);
// The op tables: 256 x 256, row = op, column = world index.
Texture2D<float> tableTex : register(t3, space2);
SamplerState tableSampler : register(s3, space2);
// The palette, 256 x 1, as shown (gamma applied).
Texture2D<float4> paletteTex : register(t4, space2);
SamplerState paletteSampler : register(s4, space2);

cbuffer Composite : register(b0, space3)
{
    // The screen texture's size in pixels (xy).
    float4 screenSize;
    // The underlay's rectangle on the screen: left, top, width, height.
    float4 shown;
    // The world surface's size in pixels (xy); the world texture's allocated size (zw).
    float4 worldSize;
};

struct PSInput
{
    float4 v_color : COLOR0;
    float2 v_uv : TEXCOORD0;
};

uint IndexAt(Texture2D<float> tex, SamplerState samp, float2 texel, float2 size)
{
    return (uint)round(tex.Sample(samp, (texel + 0.5) / size) * 255.0);
}

float4 main(PSInput input) : SV_Target
{
    const float2 pixel = floor(input.v_uv * screenSize.xy);
    uint index = IndexAt(screenTex, screenSampler, pixel, screenSize.xy);

    if (index == 255)
    {
        // The world pixel under this pixel's centre: (2 * offset + 1) * surface / (2 * shown), as the CPU picks it.
        const float2 offset = pixel - shown.xy;
        const float2 world = clamp(floor((2.0 * offset + 1.0) * worldSize.xy / (2.0 * shown.zw)), 0.0, worldSize.xy - 1.0);
        const uint worldIndex = IndexAt(worldTex, worldSampler, world, worldSize.zw);
        const uint op = IndexAt(opTex, opSampler, pixel, screenSize.xy);
        index = IndexAt(tableTex, tableSampler, float2(worldIndex, op), float2(256.0, 256.0));
    }

    const float4 color = paletteTex.Sample(paletteSampler, float2((index + 0.5) / 256.0, 0.5));
    return float4(color.rgb, 1.0) * input.v_color;
}

"$(MCDxc)" -T vs_6_0 -E main -spirv "%(FullPath)" -Fh "$(MCGeneratedDir)shaders\%(Filename).spv.h" -Vn MC_%(Filename)_spirv</Command>
      <Outputs>$(MCGeneratedDir)shaders\%(Filename).spv.h</Outputs>
      <AdditionalInputs>%(FullPath);$(MCDxc)</AdditionalInputs>

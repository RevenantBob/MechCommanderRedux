  <!-- mimalloc (src\lib\mimalloc-3.3.1): static.c compiles the whole allocator in one unit. It lives outside MCCore,
       so it has its own ItemGroup, which sync_projects.py leaves alone. platform\MCAllocator.cpp wires it in. -->
  <ItemGroup>
    <ClCompile Include="$(MCLibDir)mimalloc-3.3.1\src\static.c">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <!-- As mimalloc's own Visual Studio project does: in C, MSVC's atomics shim warns (C4047, C4024). -->
      <CompileAs>CompileAsCpp</CompileAs>
    </ClCompile>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
